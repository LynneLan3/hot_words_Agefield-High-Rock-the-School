---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { game } from '../../config/game';
import type { GameCategory } from '../../config/game';
import GuideGrid from '../../components/GuideGrid.astro';
import { categoryIdOf, getGuides, sortGuides } from '../../lib/guides';

export function getStaticPaths() {
	const hub = game.hubPath.replace(/^\/+|\/+$/g, '');
	return game.categories.map((category) => ({
		params: { hub, categoryId: category.id },
		props: { category },
	}));
}

interface Props {
	category: GameCategory;
}

const { category } = Astro.props;
const guides = (await getGuides())
	.filter((entry) => categoryIdOf(entry) === category.id)
	.sort(sortGuides);
---

<StarlightPage
	frontmatter={{
		title: category.label,
		description: category.description,
		template: 'doc',
		pagefind: false,
		lastUpdated: false,
		prev: false,
		next: false,
		category: category.id,
		head: [
			{
				tag: 'meta',
				attrs: { name: 'robots', content: 'noindex,follow' },
			},
		],
	}}
>
	<p>{category.description}</p>
	{
		guides.length > 0 && (
			<section class="gw-section">
				<h2>Guides in {category.label}</h2>
				<GuideGrid entries={guides} />
			</section>
		)
	}
</StarlightPage>
